# Caddy gets free, automatic HTTPS just from having a real domain here —
# no certificate files, no renewal cron job, nothing else to configure.
# Replace yourdomain.com with your actual domain before deploying, and
# make sure its DNS A record points at this server's IP first.
yourdomain.com {
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
