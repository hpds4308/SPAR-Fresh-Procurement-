# Backend-only settings. Copy this file to backend/.env (local dev) or
# backend/.env.production (hosting — see docs/HOSTING.md) and fill in
# real values. Never commit the real file.
#
# Docker Compose loads this per-service (env_file:) — it's read only by
# the backend and the harti-price-import container, never by the
# frontend. Frontend config is separate: see frontend/.env.example.

APP_ENV=development

# Which origins the browser is allowed to call the API from. The dev
# default below matches the Vite dev server and a couple of common local
# ports — for hosting, set this to your real domain instead, e.g.
# CORS_ORIGINS=["https://yourdomain.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Only needed if running the backend outside Docker Compose — both
# docker-compose.yml and docker-compose.prod.yml set DATABASE_URL
# themselves (they know the db container's real password), so this
# value is otherwise unused.
DATABASE_URL=postgresql+psycopg2://spar_user:spar_password@db:5432/spar_procurement

# Auth — generate a real random string for SECRET_KEY, e.g.: openssl rand -hex 32
SECRET_KEY=changeme-generate-a-real-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Business defaults (also editable later via Admin > Settings)
BRANCH_ORDER_DEADLINE=14:00
SUPPLIER_PRICE_DEADLINE=12:00

# Email — required for "Send to Master Data" on the Master Data Sheet page
# to actually send. Leave SMTP_HOST blank to disable email-sending
# features cleanly (they'll return a clear error instead of failing).
# Example values for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USERNAME=your address, SMTP_PASSWORD=an app password (not your
# normal password — Gmail requires a 16-character app password with 2FA
# enabled: https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# 24X7Retail / Dynamic Web POS integration — required for "Stock in Hand"
# on the branch New Order page. Leave POS_API_BASE_URL blank to disable
# it cleanly (the column just won't show, order placement is unaffected).
# POS_API_USERNAME/PASSWORD are the credentials the POS vendor emails you
# separately (see the Web API Document, "getToken"), not related to any
# SPAR login. Each branch also needs its POS_API location code set once,
# via PATCH /branches/{id}/pos-location-code.
POS_API_BASE_URL=
POS_API_USERNAME=
POS_API_PASSWORD=
