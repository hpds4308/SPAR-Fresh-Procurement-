# Frontend-only settings. Copy this file to frontend/.env (local dev) or
# frontend/.env.production (hosting — see docs/HOSTING.md) and fill in
# the real value. Never commit the real file.
#
# Vite loads this automatically from this directory — no Docker Compose
# wiring needed. In production it's baked into the built JS at image
# build time, not read at container startup, so it must be set before
# running `docker compose -f docker-compose.prod.yml build`.

# Where the browser sends API requests. In dev this is the backend
# container's published port. In production this is your own domain —
# Caddy proxies /api/* on that same domain through to the backend, so
# the frontend never needs a separate backend URL.
VITE_API_BASE_URL=http://localhost:8000
