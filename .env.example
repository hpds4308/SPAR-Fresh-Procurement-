# Used only by Docker Compose itself, for variable substitution in
# docker-compose.prod.yml — never read directly by the application.
# Application config lives in backend/.env and frontend/.env instead;
# see those directories' own .env.example files.
#
# Local dev (docker-compose.yml) doesn't need this file at all — the
# dev Postgres password is hardcoded there since it's never internet-
# facing. Copy this to .env.production only when hosting for real (see
# docs/HOSTING.md), alongside backend/.env.production and
# frontend/.env.production.

# Generate one for production: openssl rand -hex 16
POSTGRES_PASSWORD=spar_password

# Used by the db-backup service (docker-compose.prod.yml only).
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
